# Copy to /opt/bookstall/.env (chmod 600). Never commit the real file.
APP_VERSION=v0.1.0
GHCR_OWNER=your-github-org-lowercase
DOMAIN=books.example.org
ACME_EMAIL=admin@example.org
PG_PASSWORD=            # openssl rand -base64 36 | tr -d '/+='   (no special URL characters)

NODE_ENV=production
JWT_ACCESS_SECRET=      # openssl rand -base64 48
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
PUBLIC_APP_URL=https://books.example.org
CORS_ORIGINS=https://books.example.org
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/data/storage
OPENLIBRARY_USER_AGENT=bookstall/1.0 (admin@example.org)
GOOGLE_BOOKS_API_KEY=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=    # only used by the one-time seed; change it at first login
LOG_LEVEL=info
