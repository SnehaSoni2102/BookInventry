{
  "name": "@bookstall/api-client",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bookstall/shared": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.4",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.4",
    "react": "^19.3.1",
    "socket.io-client": "^4.8.4"
  }
}
