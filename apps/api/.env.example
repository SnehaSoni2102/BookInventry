# --- API (see docs/02-BACKEND.md §2) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://bookstall:bookstall@localhost:5432/bookstall
JWT_ACCESS_SECRET=            # >= 32 chars; required in production (openssl rand -base64 48)
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/storage
GOOGLE_BOOKS_API_KEY=
OPENLIBRARY_USER_AGENT=bookstall/1.0 (contact@example.org)
EXTERNAL_LOOKUP_TIMEOUT_MS=5000
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
LOG_LEVEL=info
